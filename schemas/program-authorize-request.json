{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openape.org/schemas/program-authorize-request.json",
  "title": "One program call for broker authorization",
  "description": "Existing per-call authorize request. The decision provider resolves permission details; the requester cannot supply authorization details or execution context. See Grant Brokering section 5.2 for runtime byte, UTF-16 and duplicate-path constraints beyond JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "not": {
        "pattern": "\\u0000"
      }
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "not": {
        "pattern": "\\u0000"
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "not": {
            "anyOf": [
              {
                "enum": [
                  ".",
                  ".."
                ]
              },
              {
                "pattern": "[/\\u0000]"
              }
            ]
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "name",
        "sha256"
      ]
    },
    "argv": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "not": {
          "pattern": "\\u0000"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/",
            "not": {
              "pattern": "[\\u0000\\r\\n]"
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "grant_type": {
      "enum": [
        "always",
        "once"
      ],
      "default": "always"
    },
    "summary": {
      "$ref": "grant-request.json#/properties/summary"
    },
    "batch": {
      "$ref": "grant-request.json#/properties/batch"
    },
    "reference": {
      "$ref": "grant-request.json#/properties/reference"
    }
  },
  "required": [
    "target_host",
    "audience",
    "program",
    "argv"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "reference"
        ]
      },
      "then": {
        "required": [
          "grant_type"
        ],
        "properties": {
          "grant_type": {
            "const": "once"
          }
        }
      }
    }
  ]
}
