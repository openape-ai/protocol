{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://openape.org/schemas/broker-request-claims.json",
  "title": "Signed broker request claims",
  "properties": {
    "iss": {
      "type": "string",
      "format": "uri"
    },
    "sub": {
      "type": "string",
      "minLength": 1
    },
    "aud": {
      "type": "string",
      "format": "uri"
    },
    "iat": {
      "type": "integer"
    },
    "exp": {
      "type": "integer"
    },
    "jti": {
      "type": "string",
      "format": "uuid"
    },
    "connection_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "key_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "connection",
        "create",
        "authorize",
        "get",
        "token"
      ]
    },
    "request": {
      "type": "object"
    },
    "grant_id": {
      "type": "string",
      "format": "uuid"
    },
    "requester_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "not": {
            "pattern": "[\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}]"
          }
        }
      ],
      "description": "Verified broker-registered agent display name; presentation only, at most 120 Unicode code points and nonempty after trimming. Control, format and line/paragraph separator characters are forbidden."
    },
    "reference": {
      "$ref": "grant-request.json#/properties/reference"
    }
  },
  "required": [
    "iss",
    "aud",
    "iat",
    "exp",
    "jti",
    "connection_id",
    "owner",
    "operation"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "connection"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "sub"
              ]
            },
            {
              "required": [
                "key_id"
              ]
            },
            {
              "required": [
                "request"
              ]
            },
            {
              "required": [
                "grant_id"
              ]
            },
            {
              "required": [
                "requester_name"
              ]
            },
            {
              "required": [
                "reference"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "sub",
          "key_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "create",
              "authorize"
            ]
          }
        }
      },
      "then": {
        "required": [
          "request"
        ],
        "not": {
          "required": [
            "grant_id"
          ]
        }
      },
      "else": {
        "not": {
          "required": [
            "request"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "get"
          }
        }
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "grant_id"
            ],
            "not": {
              "required": [
                "reference"
              ]
            }
          },
          {
            "required": [
              "reference"
            ],
            "not": {
              "required": [
                "grant_id"
              ]
            }
          }
        ]
      },
      "else": {
        "not": {
          "required": [
            "reference"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "create"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "$ref": "grant-request.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "authorize"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "$ref": "program-authorize-request.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "token"
          }
        }
      },
      "then": {
        "required": [
          "grant_id"
        ]
      }
    }
  ]
}
